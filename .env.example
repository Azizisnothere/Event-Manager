# Copy to .env and fill in. NEVER commit .env. No real values in this file.
PORT=3000
CORS_ORIGINS=http://localhost:8080
# Neon: app connection (later the restricted user em_app) and owner connection (migrations only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full
MIGRATION_DATABASE_URL=postgresql://neondb_owner:PASSWORD@HOST/neondb?sslmode=verify-full
